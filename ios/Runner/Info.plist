<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>en</string>
		<key>CFBundleDisplayName</key>
		<string>EliteMeet</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>net.elitemeet.app</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>EliteMeet</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<!-- Section 5: portrait lock -->
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<!-- A portrait-only iPad app must opt out of iPad multitasking, or
		     App Store Connect rejects the upload (all four orientations are
		     otherwise required on iPad). -->
		<key>UIRequiresFullScreen</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<!-- UIScene lifecycle (required by upcoming iOS SDKs). Pairs with
		     AppDelegate.swift's FlutterImplicitEngineDelegate. -->
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneDelegateClassName</key>
						<string>FlutterSceneDelegate</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<!-- url_launcher's canLaunchUrl needs these declared on iOS (same
		     role as <queries> in AndroidManifest.xml). https needs none. -->
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>tel</string>
			<string>mailto</string>
		</array>
		<!-- Only standard HTTPS/TLS encryption — answers App Store Connect's
		     export-compliance question so every upload isn't held for it. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<!-- Section 62: specific, non-generic usage strings — Apple review
	     flags vague copy like "This app needs camera access". Replace
	     these with EliteMeet's actual copy if different, but keep them
	     specific to what the feature is for. -->
		<key>NSCameraUsageDescription</key>
		<string>EliteMeet uses your camera for video calls with your matches and to take profile photos.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>EliteMeet uses your microphone for voice and video calls with your matches.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>EliteMeet needs access to your photo library so you can choose a profile photo.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>EliteMeet can save photos to your library when you download an image from the app.</string>
		<!-- Section 70: geolocation, confirmed in use for nearby-matches. -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>EliteMeet uses your location to show nearby matches.</string>
		<!-- Required by App Store upload checks (ITMS-90683) because a plugin
		     references the "always" location API. The app only ever asks for
		     when-in-use access. -->
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>EliteMeet uses your location to show nearby matches. It is only used while you are using the app.</string>
		<!-- Section 10: push notifications. voip = PushKit incoming-call
		     pushes that ring full-screen via CallKit (AppDelegate.swift). -->
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
			<string>voip</string>
		</array>
		<key>FirebaseAppDelegateProxyEnabled</key>
		<false/>
		<!-- Section 6: WebView / networking. cleartext is blocked by default
	     (no NSAllowsArbitraryLoads) — HTTPS-only per Section 25. -->
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
	</dict>
</plist>
