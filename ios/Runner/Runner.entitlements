<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications (FCM delivers through APNs). Xcode switches this
	     to "production" automatically when exporting for the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links — iOS side of Android's App Links intent filter.
	     Needs https://elitemeet.net/.well-known/apple-app-site-association
	     (see docs/DEEP_LINKS.md). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:elitemeet.net</string>
		<string>applinks:www.elitemeet.net</string>
	</array>
	<!-- Incoming-call pushes are sent with interruption-level
	     "time-sensitive" (call-push.server.ts) so they break through Focus. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
